FROM debian:trixie-20261020@sha256:4c25275446ca371766b8b093c696782eabce06263fccacb8d5d813b3dc44b308
RUN rm /etc/apt/sources.list.d/debian.sources && printf 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20261025T000000Z/ trixie main\n' > /etc/apt/sources.list && apt-get -o Acquire::Retries=3 update && apt-get install -y --no-install-recommends python3 ca-certificates curl iptables tini && rm -rf /var/lib/apt/lists/*
ARG CHANNEL_RELEASE=https://github.com/irislib/iris-chat-channels/releases/download/v0.2.2
ARG OPENCLAW_CHANNEL_SHA256=76d65a5574c7ef7fb9a6ab85afcb51512b677fae8e405c5c6b59bb5449543566
ARG HERMES_CHANNEL_SHA256=754176c84931c5ec6a42f6541a28e1e295014c08378c28fea44e1509b8f8ca72
RUN mkdir -p /opt/iris-channels/hermes /opt/iris-channels/openclaw && curl -fsSL --retry 3 "$CHANNEL_RELEASE/iris-hermes-0.2.2.tgz" -o /tmp/hermes.tgz && echo "$HERMES_CHANNEL_SHA256  /tmp/hermes.tgz" | sha256sum -c - && tar -xzf /tmp/hermes.tgz -C /opt/iris-channels/hermes && curl -fsSL --retry 3 "$CHANNEL_RELEASE/iris-openclaw-0.2.2.tgz" -o /opt/iris-channels/openclaw.tgz && echo "$OPENCLAW_CHANNEL_SHA256  /opt/iris-channels/openclaw.tgz" | sha256sum -c - && rm /tmp/hermes.tgz
COPY runtime /opt/iris-agent
RUN cp /opt/iris-channels/hermes/transport.py /opt/iris-agent/channel_transport.py
ENTRYPOINT ["tini", "--"]
