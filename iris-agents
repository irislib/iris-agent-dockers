#!/usr/bin/env python3
"""Manage persistent Hermes/OpenClaw containers without an AI coding tool."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import sys

ROOT=Path(__file__).resolve().parent
os.chdir(ROOT)
parser=argparse.ArgumentParser(description=__doc__)
sub=parser.add_subparsers(dest='command',required=True)
for action in ['up','stop','status','build','check']: sub.add_parser(action)
for action in ['shell','logs','pair']:
    p=sub.add_parser(action);p.add_argument('agent',choices=['hermes','openclaw'])
    if action=='pair':
        p.add_argument('--owner',required=True,help='The only permitted contact, as an npub')
        p.add_argument('--invite',help='Invite URL; omitted to read it without echo')
args=parser.parse_args()
compose=['docker','compose','-f',str(ROOT/'compose.yaml')]
def run(argv,**kwargs): return subprocess.run(argv,check=True,**kwargs)
if args.command=='build':
    run(['docker','build','--platform','linux/amd64','-f','Dockerfile.support','-t','iris-agent-support:local','.'])
    run(['docker','build','--platform','linux/amd64','-f','Dockerfile.iris','-t','iris-agent-iris:local','.'])
    for backend in ('hermes','openclaw'):
        run(['docker','build','-f','Dockerfile.'+backend,'-t','iris-agent-'+backend+':local','.'])
elif args.command=='up': run(compose+['up','-d'])
elif args.command=='stop': run(compose+['stop'])
elif args.command=='status': run(compose+['ps'])
elif args.command=='shell': run(compose+['exec',args.agent,'bash'])
elif args.command=='logs': run(compose+['logs','--tail','100','-f',args.agent,args.agent+'-iris'])
elif args.command=='check': run([sys.executable,str(ROOT/'tests/live_check.py')])
elif args.command=='pair':
    import getpass
    invite=args.invite or getpass.getpass('Private Iris invite: ')
    run(compose+['exec','-T',args.agent+'-iris','python3','/opt/iris-agent/pair.py'],
        input=json.dumps({'owner':args.owner,'invite':invite}),text=True)
